# caddy/Caddyfile
#
# Reverse proxy for Forge CI/CD — handles TLS via DuckDNS DNS-01 challenge.
#
# All browser traffic — Web UI, REST API, SSE log streams, webhooks,
# and debug terminal WebSockets — routes through the scheduler.
# Agents are internal only; no per-agent routing rules needed here.
# Add or remove agents freely without touching this file.
#
# Prerequisites (.env):
#   FORGE_DOMAIN=yourname.duckdns.org
#   DUCKDNS_TOKEN=xxxxxxxx-xxxx-...
#   ACME_EMAIL=you@example.com

{env.FORGE_DOMAIN} {

    # TLS via Let's Encrypt using DuckDNS DNS-01 challenge.
    # No port 80 required — certificate validated through DNS.
    tls {
        dns duckdns {env.DUCKDNS_TOKEN}
    }

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "SAMEORIGIN"
        Referrer-Policy           "strict-origin-when-cross-origin"
        -Server
    }

    # All traffic → Forge scheduler.
    #
    # The scheduler handles:
    #   GET  /                                    Web UI
    #   *    /api/v1/...                          REST API
    #   GET  /api/v1/runs/{id}/events             SSE log stream
    #   GET  /api/v1/debug/{id}/ws                Debug terminal (WS proxy to agent)
    #   POST /api/v1/webhook/github/{id}          GitHub webhooks
    #   POST /api/v1/webhook/gitlab/{id}          GitLab webhooks
    #
    # Caddy handles WebSocket upgrade (HTTP → WS) automatically.
    # flush_interval -1 prevents buffering for SSE streams.
    reverse_proxy scheduler:8080 {
        header_up Host              {upstream_hostport}
        header_up X-Real-IP         {remote_host}
        header_up X-Forwarded-For   {remote_host}
        header_up X-Forwarded-Proto {scheme}
        flush_interval              -1
    }
}

# HTTP → HTTPS redirect
http://{env.FORGE_DOMAIN} {
    redir https://{host}{uri} permanent
}
