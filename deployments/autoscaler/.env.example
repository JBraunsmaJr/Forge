# Scheduler this autoscaler manages agents for. Use the scheduler's
# externally reachable address, not a Docker-internal hostname.
FORGE_SCHEDULER_URL=https://forge.lab.myDomain.dev

# Token used to call the scheduler's agent/queue endpoints.
# Must match a token with the 'agent' role configured on the scheduler.
FORGE_AGENT_TOKEN=fgt_token_here

# ── Pool sizing ─────────────────────────────────────────────────────────────
FORGE_AUTOSCALER_HOT_POOL_SIZE=1
FORGE_AUTOSCALER_MAX_BURST_SIZE=10

# ── Azure VM Scale Sets ─────────────────────────────────────────────────────
FORGE_AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
FORGE_AZURE_RESOURCE_GROUP=forge-agents-rg
FORGE_AZURE_HOT_VMSS=forge-agents-hot
FORGE_AZURE_BURST_VMSS=forge-agents-burst

# Service principal used by the Azure SDK's default credential chain.
# Grant it a scoped role (e.g. Virtual Machine Contributor) on the
# resource group above -- it does not need subscription-wide Contributor.
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=your-service-principal-secret
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
