# .env.example — copy to .env and fill in your values
#
# Usage:
#   cp .env.example .env
#   docker compose up --build -d

# ── Admin token ───────────────────────────────────────────────────────────────
# Pre-sets the root admin token for reproducible dev environments.
# If not set, a random token is auto-generated on first scheduler start
# and printed once to the console. Change this for staging/production.
FORGE_ROOT_TOKEN=forge-dev-admin-token

# Agent token — least-privilege token for agents (created by init.sh)
# Must differ from FORGE_ROOT_TOKEN so agents cannot perform admin operations
FORGE_AGENT_TOKEN=forge-dev-agent-token

# ── Agent WebSocket host ──────────────────────────────────────────────────────
# The hostname or IP browsers use to reach agent WebSocket debug terminals.
# Defaults to localhost (works when browser and compose run on the same machine).
# Set to your machine's LAN IP if testing from another device on the network:
#   FORGE_AGENT_HOST=192.168.1.100
FORGE_AGENT_HOST=localhost

# ── HTTPS / DuckDNS (optional — for internet-facing deployments) ──────────────
# Required when using: docker compose -f compose.yml -f docker-compose.https.yml up
#
# Setup:
#   1. Create a free account at https://www.duckdns.org
#   2. Create a subdomain — you get yourname.duckdns.org
#   3. Copy your token from the account page
#   4. Forward port 443 (TCP) on your router to this machine
#
# FORGE_DOMAIN=yourname.duckdns.org
# DUCKDNS_SUBDOMAIN=yourname
# DUCKDNS_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# ACME_EMAIL=you@example.com
