# .env.example — copy to .env and fill in your values
#
# Usage:
#   cp .env.example .env
#   docker compose up --build -d

# ── Admin token ───────────────────────────────────────────────────────────────
# Pre-sets the root admin token for reproducible dev environments.
# If not set, a random token is auto-generated on first scheduler start
# and printed once to the console. Change this for staging/production.
FORGE_ROOT_TOKEN=forge-dev-admin-token

# Agent token — least-privilege token for agents (created by init.sh)
# Must differ from FORGE_ROOT_TOKEN so agents cannot perform admin operations
FORGE_AGENT_TOKEN=forge-dev-agent-token

# ── Retention & Cleanup ───────────────────────────────────────────────────────
# How long to keep job runs and artifacts (e.g. 30d, 7d, 24h, 30m).
# Pruning a run automatically deletes its artifacts from Local/S3 storage.
# Defaults to 30d.
FORGE_RUN_RETENTION=30d

# How often to check for expired runs (e.g. 24h, 1h). Defaults to 24h.
FORGE_RUN_RETENTION_INTERVAL=24h

# Path to persistent cache storage for distributed caching (Scheduler only).
# Defaults to /data/cache.
FORGE_CACHE_DIR=/var/lib/forge/cache

# Log retention in days. Logs older than this will be pruned hourly.
# Defaults to 30.
FORGE_LOG_RETENTION_DAYS=30

# ── Auth & SSO ──────────────────────────────────────────────────────────────
# Configure GitHub OAuth2 for Single Sign-On.
# 1. Register a new OAuth App at https://github.com/settings/developers
# 2. Homepage URL: http://localhost:8080 (or your public domain)
# 3. Callback URL: http://localhost:8080/api/v1/auth/callback/github
#
# Configure GitLab OAuth2 for Single Sign-On.
# 1. Register a new Application at https://gitlab.com/-/profile/applications
# 2. Redirect URI: http://localhost:8080/api/v1/auth/callback/gitlab
# 3. Scopes: read_user, openid
#
# FORGE_GITHUB_CLIENT_ID=
# FORGE_GITHUB_CLIENT_SECRET=
#
# FORGE_GITLAB_CLIENT_ID=
# FORGE_GITLAB_CLIENT_SECRET=
#
# The public URL of the scheduler, used for OAuth callbacks.
# FORGE_PUBLIC_URL=http://localhost:8080
#
# The URL to redirect to after successful SSO login (the Web UI).
# FORGE_UI_URL=http://localhost:8080

# ── Development ───────────────────────────────────────────────────────────────
# Enable hot reload for the UI.
#
# Option A: Run Vite in Docker (using compose.yml)
#   This is enabled by default in compose.yml (FORGE_UI_DEV_URL=http://ui:5173).
#   Vite is configured to use polling in Docker for compatibility with Windows hosts.
#
# Option B: Run Vite on Host (faster startup)
#   1. Start the UI dev server: cd ui; npm install; npm run dev
#   2. Set FORGE_UI_DEV_URL to the dev server URL:
#      FORGE_UI_DEV_URL=http://localhost:5173
#   3. Start the scheduler (on host or in Docker).
#      If scheduler is in Docker, use your host IP (e.g. http://192.168.x.x:5173)
#      or "host.docker.internal" (on Windows/Mac): http://host.docker.internal:5173
#
# FORGE_UI_DEV_URL=http://ui:5173

# ── HTTPS / DuckDNS (optional — for internet-facing deployments) ──────────────
# Required when using: docker compose -f compose.yml -f docker-compose.https.yml up
#
# Setup:
#   1. Create a free account at https://www.duckdns.org
#   2. Create a subdomain — you get yourname.duckdns.org
#   3. Copy your token from the account page
#   4. Forward port 443 (TCP) on your router to this machine
#
# FORGE_DOMAIN=yourname.duckdns.org
# DUCKDNS_SUBDOMAIN=yourname
# DUCKDNS_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# ACME_EMAIL=you@example.com
